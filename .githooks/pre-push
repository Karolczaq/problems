#!/usr/bin/env bash

set -euo pipefail

[ -f mix.exs ] || exit 0

cat >/dev/null

run() {
  echo "==> $*"
  if ! "$@"; then
    echo "" >&2
    echo "pre-push: '$*' failed" >&2
    exit 1
  fi
}

run mix format --check-formatted
run mix deps.unlock --check-unused
run mix compile --warnings-as-errors
run mix test

echo "pre-push completed successfully."
